{
  "name": "ai-interview-prep-kit",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/api", "apps/web", "packages/core"],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm run build:core && npm run build:api && npm run build:web",
    "build:core": "npm --workspace packages/core run build",
    "build:api": "npm --workspace apps/api run build",
    "build:web": "npm --workspace apps/web run build",
    "evaluate": "npm run build:core --silent && tsx apps/api/src/cli/evaluate.ts",
    "test": "npm run build:core --silent && vitest run"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
